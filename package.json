{
  "name": "contracts-manager",
  "version": "0.7.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma generate && if [ \"$VERCEL\" = \"1\" ]; then npx prisma migrate deploy; fi && if [ \"$VERCEL\" = \"1\" ] && [ \"$RUN_SEED\" = \"1\" ]; then node prisma/seed.mjs; fi && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@base-ui/react": "^1.4.1",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.0.13",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/client": "^5.22.0",
    "@react-pdf/renderer": "^4.1.6",
    "@types/jsonwebtoken": "^9.0.10",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.7.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.14.0",
    "maplibre-gl": "^6.9.0",
    "next": "16.1.3",
    "next-auth": "^4.24.11",
    "numero-a-letras": "^1.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.6.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "webpack": "^5.110.3"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/maplibre-gl": "^1.13.2",
    "@types/node": "^20.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.12",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.1.3",
    "postcss": "^8.4.17",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.0.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "24.x"
  }
}
